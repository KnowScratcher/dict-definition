{"text": "bony", "etymologies": [{"etymologyHTML": "<p>From Middle English <i class=\"Latn mention\" lang=\"enm\">bony</i>, equivalent to <i class=\"Latn mention\" lang=\"en\">bone</i> +\u200e <i class=\"Latn mention\" lang=\"en\">-y</i>.\n</p>", "pos": [{"pos": "Adjective", "definitions": [{"definition": "resembling, having the appearance or consistence of, or relating to bone; osseous.", "quote": [], "relative": {}}, {"definition": "full of bones", "quote": [], "relative": {}}, {"definition": "with little flesh; skinny, thin", "quote": [], "relative": {}}, {"definition": "having prominent bones", "quote": [], "relative": {}}]}]}], "pronunciation": [["General American", "/\u02c8bo\u028ani/"], ["Received Pronunciation", "/\u02c8b\u0259\u028ani/"]]}