{"text": "yeah", "etymologies": [{"etymologyHTML": "<p>Colloquial form of <i class=\"Latn mention\" lang=\"en\">yea</i> or <i class=\"Latn mention\" lang=\"en\">yes</i>. Compare <i class=\"Latn mention\" lang=\"en\">nah</i>.\n</p>", "pos": [{"pos": "Interjection", "definitions": [{"definition": "Expressing joy, celebration, glee, etc.\n", "quote": [], "relative": {}}]}]}, {"etymologyHTML": "<p>See year.\n</p>", "pos": [{"pos": "Noun", "definitions": [{"definition": "Pronunciation spelling of year.", "quote": [], "relative": {}}]}]}], "pronunciation": [["IPA", "/\u02c8j\u025b(\u0259)/"]]}