{"text": "chemical", "etymologies": [{"etymologyHTML": "<p>From <i class=\"Latn mention\" lang=\"en\">chemic</i> (\u201calchemy\u201d) +\u200e <i class=\"Latn mention\" lang=\"en\">-al</i> (\u201crelated to\u201d).\n</p>", "pos": [{"pos": "Adjective", "definitions": [{"definition": "Of or relating to chemistry.\n", "quote": [], "relative": {}}, {"definition": "Of or relating to a material or processes not commonly found in nature or in a particular product.", "quote": [], "relative": {}}, {"definition": "(obsolete) Of or relating to alchemy.", "quote": [], "relative": {}}]}, {"pos": "Noun", "definitions": [{"definition": "(chemistry, sciences) Any specific chemical element or chemical compound or alloy.\n", "quote": [], "relative": {}}, {"definition": "(colloquial) An artificial chemical compound.\n", "quote": [], "relative": {}}, {"definition": "(slang) An addictive drug.", "quote": [], "relative": {}}]}]}], "pronunciation": [["IPA", "/\u02c8k\u025bm\u026ak\u0259l/"]]}