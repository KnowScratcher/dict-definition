{"text": "anywhere", "etymologies": [{"etymologyHTML": "<p>From <i class=\"Latn mention\" lang=\"en\">any</i> +\u200e <i class=\"Latn mention\" lang=\"en\">where</i>.\n</p>", "pos": [{"pos": "Adverb", "definitions": [{"definition": "In or at any location.\n", "quote": [], "relative": {}}, {"definition": "To (in the direction of) any location.\n", "quote": [], "relative": {}}]}, {"pos": "Pronoun", "definitions": [{"definition": "Any location or an unknown location.\n", "quote": [], "relative": {}}]}, {"pos": "Noun", "definitions": [{"definition": "A person without strong cultural or social ties to a specific place; a cosmopolite.\n", "quote": [], "relative": {"Synonym": ["cosmopolite"], "Antonym": ["somewhere"]}}]}]}], "pronunciation": [["UK", "/\u02c8\u025bn.i\u02d0.(h)w\u025b\u0259(\u0279)/"], ["US", "/\u02c8\u025bn.i.(h)w\u025b\u0279/"], ["Received Pronunciation", "/\u02c8\u025bn\u026aw\u025b\u0259/"]]}