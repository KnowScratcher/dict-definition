{"text": "technician", "etymologies": [{"etymologyHTML": "<p>From <i class=\"Latn mention\" lang=\"en\">technic</i> +\u200e <i class=\"Latn mention\" lang=\"en\">-ian</i>.\n</p>", "pos": [{"pos": "Noun", "definitions": [{"definition": "A person who studies or practises technology; an expert in a particular technology.\n", "quote": [], "relative": {"Synonyms": ["tech (clipping)", "techie", "technologist (often synonymous)"], "Antonym": ["Luddite"], "Coordinate terms": ["engineer", "mechanic"]}}]}]}], "pronunciation": [["IPA", "/t\u025bk\u02c8n\u026a\u0283\u0259n/"]]}