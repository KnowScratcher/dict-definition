{"text": "emotional", "etymologies": [{"etymologyHTML": "<p>From <i class=\"Latn mention\" lang=\"en\">emotion</i> +\u200e <i class=\"Latn mention\" lang=\"en\">-al</i>.\n</p>", "pos": [{"pos": "Adjective", "definitions": [{"definition": "Of or relating to the emotions.\n", "quote": [], "relative": {"Synonym": ["temperamental"]}}, {"definition": "Characterised by emotion.\n", "quote": [], "relative": {"Synonym": ["sentimental"]}}, {"definition": "Determined by strong emotion rather than purely logical reasoning.\n", "quote": [], "relative": {"Synonym": ["sentimental"]}}, {"definition": "Appealing to or arousing emotion.\n", "quote": [], "relative": {}}, {"definition": "Easily affected by emotion.\n", "quote": [], "relative": {"Synonyms": ["passionate", "perfervid"]}}, {"definition": "Readily displaying emotion.\n", "quote": [], "relative": {"Synonyms": ["demonstrative", "effusive"]}}]}, {"pos": "Noun", "definitions": [{"definition": "An emotional person", "quote": [], "relative": {}}]}]}], "pronunciation": [["Received Pronunciation", "/\u026a\u02c8m\u0259\u028a\u0283\u0259n\u0259l/"], ["General American", "/\u026a\u02c8mo\u028a\u0283\u0259n\u0259l/"]]}